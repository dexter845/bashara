{{ 'bashara-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="section color-{{ s.color_scheme }} bashara-page bashara-about-cta">
  {%- if s.image != blank -%}
    <div class="bashara-about-cta__media">
      {{
        s.image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '800, 1200, 1600',
          sizes: '100vw',
          alt: s.image.alt | default: s.heading
      }}
    </div>
  {%- endif -%}
  <div class="bashara-about-cta__overlay"></div>
  <div class="bashara-about-cta__content">
    {%- if s.heading != blank -%}
      <h2 class="bashara-page__title bashara-page__title--md">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p class="bashara-page__body">{{ s.description | escape }}</p>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="bashara-about-cta__button">
        {{ s.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bashara About CTA",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to start your glow journey?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated collection of Korean skincare essentials."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bashara About CTA"
    }
  ]
}
{% endschema %}
