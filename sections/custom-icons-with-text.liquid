

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{%- assign s = section.settings -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<div
  class="section section--{{ s.section_width }} color-{{ s.color_scheme }}"
  data-testid="ui-test-section"

  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    {% if s.section_height == 'custom' %}
      --section-min-height: {{ s.section_height_custom }}svh;
    {% elsif s.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif s.section_height != '' %}
      --section-min-height: var(--section-height-{{ s.section_height }});
    {% endif %}
    {% if s.section_height != '' %}
      --section-preview-height: 600px;
    {% endif %}
  "
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: s.background_media,
      background_video: s.video,
      background_video_position: s.video_position,
      background_image: s.background_image,
      background_image_position: s.background_image_position
    %}
  </div>

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: s %}"
  >
    {% if s.toggle_overlay %}
      {% render 'overlay', settings: s, layer: '0' %}
    {% endif %}

    <div
      class="spacing-style custom-icons-with-text__outer"
      style="{% render 'spacing-style', settings: s %}"
    >
      {%- if s.heading != blank or s.subheading != blank -%}
        <div
          class="custom-icons-with-text__header"
          style="
            text-align: {{ s.header_alignment }};
            --header-gap: {{ s.header_gap }}px;
          "
        >
          {%- if s.heading != blank -%}
            <{{ s.heading_size }} class="custom-icons-with-text__heading">
              {{ s.heading | escape }}
            </{{ s.heading_size }}>
          {%- endif -%}
          {%- if s.subheading != blank -%}
            <p class="custom-icons-with-text__subheading">
              {{ s.subheading | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="
          layout-panel-flex
          layout-panel-flex--{{ s.content_direction }}
          section-content-wrapper
          {% if s.vertical_on_mobile %} mobile-column{% endif %}
        "
        style="{% render 'layout-panel-style', settings: s %}"
        data-testid="section-content"
      >
        {{ children }}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-icons-with-text__outer {
    display: flex;
    flex-direction: column;
    gap: var(--header-gap, 16px);
    width: 100%;
  }

  .custom-icons-with-text__header {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .custom-icons-with-text__heading {
    margin: 0;
  }

  .custom-icons-with-text__subheading {
    margin: 0;
    opacity: 0.75;
  }
{% endstylesheet %}

