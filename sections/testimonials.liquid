{{ 'testimonials.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }} section--testimonials"
  class="section-background color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="testimonials__inner">
    <div class="testimonials__header">
      <h4 class="testimonials__subtitle">{{ section.settings.subtitle }}</h4>
      <h2 class="testimonials__title">{{ section.settings.title }}</h2>
      <span class="testimonials__description">{{ section.settings.description }}</span>
    </div>
    <div class="testimonials__content swiper testimonials__swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% render 'testimonial-item', block: block, slider: true %}
        {% endfor %}
      </div>
      <div class="swiper-button-next testimonials__swiper-button-next">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.833344 10.834L5.83334 5.83398L0.833344 0.833984" stroke="#3B3530" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="swiper-button-prev testimonials__swiper-button-prev">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5.83334 10.834L0.833344 5.83398L5.83334 0.833984" stroke="#3B3530" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      {% if section.settings.quote_image %}
        <div class="testimonials__content__quote">
          <img src="{{ section.settings.quote_image | image_url: width: 128 }}" alt="Quote" width="128" height="128">
        </div>
      {% endif %}
    </div>
    <div class="swiper thumbs__swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <img src="{{ block.settings.author_image | image_url: width: 100 }}" alt="{{ block.settings.author_name }}" width="100" height="100">
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="testimonials__stats__inner">
      <div class="testimonials__stats__item">
        <span class="testimonials__stats__item__number">15,000+</span>
        <span class="testimonials__stats__item__text">Happy Customers</span>
      </div>
      <div class="testimonials__stats__item">
        <span class="testimonials__stats__item__number">4.9</span>
        <span class="testimonials__stats__item__text">Average Rating</span>
      </div>
      <div class="testimonials__stats__item">
        <span class="testimonials__stats__item__number">98%</span>
        <span class="testimonials__stats__item__text">Would Recommend</span>
      </div>
      <div class="testimonials__stats__item">
        <span class="testimonials__stats__item__number">2,400+</span>
        <span class="testimonials__stats__item__text">5-Star Reviews</span>
      </div>
    </div>
  </div>


</div>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    var thumbsEl = document.querySelector('.thumbs__swiper');
    var mainEl = document.querySelector('.testimonials__swiper');

    if (!thumbsEl || !mainEl || mainEl.querySelectorAll('.swiper-slide').length === 0) return;

    var thumbsSwiper = new Swiper(thumbsEl, {
      spaceBetween: 10,
      slidesPerView: 4,
      freeMode: true,
      watchSlidesProgress: true,
    });

    new Swiper(mainEl, {
      spaceBetween: 10,
      navigation: {
        nextEl: '.testimonials__swiper-button-next',
        prevEl: '.testimonials__swiper-button-prev',
      },
      thumbs: {
        swiper: thumbsSwiper,
      },
    });
  });
</script>

{% schema %}
  {
    "name": "Testimonials",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:settings.color_scheme",
        "default": "scheme-1"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top_padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom_padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "image_picker",
        "id": "quote_image",
        "label": "Quote Image"
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial Item",
        "settings": [
          {
            "type": "header",
            "content": "Testimonial"
          },
          {
            "type": "text",
            "id": "testimonial",
            "label": "Testimonial"
          },
          {
            "type": "number",
            "id": "rating",
            "label": "Rating",
            "info": "0 to 5",
            "default": 5
          },
          {
            "type": "checkbox",
            "id": "is_verified",
            "label": "Is Verified",
            "default": false
          },
          {
            "type": "text",
            "id": "author_name",
            "label": "Author Name"
          },
          {
            "type": "image_picker",
            "id": "author_image",
            "label": "Author Image"
          },
          {
            "type": "text",
            "id": "author_address",
            "label": "Author Address"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "text",
            "id": "description",
            "label": "Description"
          }
        ]
      }
    ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}