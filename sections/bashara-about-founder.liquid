{{ 'bashara-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="section color-{{ s.color_scheme }} bashara-page bashara-about-founder">
  <div class="bashara-page__inner">
    <div class="bashara-about-founder__grid">
      {%- if s.image != blank -%}
        <div class="bashara-about-founder__image">
          {{
            s.image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800',
              sizes: '(min-width: 900px) 40vw, 100vw',
              alt: s.image.alt | default: s.heading
          }}
        </div>
      {%- endif -%}

      <div class="bashara-about-founder__content">
        {%- if s.eyebrow != blank -%}
          <p class="bashara-page__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="bashara-page__title bashara-page__title--md">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.letter != blank -%}
          <div class="bashara-about-founder__letter rte">{{ s.letter }}</div>
        {%- endif -%}
        {%- if s.signature != blank -%}
          <p class="bashara-about-founder__signature">{{ s.signature | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bashara About Founder",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From Our Founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Letter from the Founder"
    },
    {
      "type": "richtext",
      "id": "letter",
      "label": "Letter content",
      "default": "<p>When I started GLOWRA, I wanted to bring the skincare rituals I grew up with in Korea to everyone seeking healthy, radiant skin. Every formula we create is tested, refined, and made with the same care I'd give my own family.</p><p>Thank you for trusting us with your skin journey.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— The GLOWRA Team"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bashara About Founder"
    }
  ]
}
{% endschema %}
