{{ 'bashara-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="section color-{{ s.color_scheme }} bashara-page bashara-about-ingredients">
  <div class="bashara-page__inner">
    <div class="bashara-about-ingredients__header">
      {%- if s.eyebrow != blank -%}
        <p class="bashara-page__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="bashara-page__title bashara-page__title--md">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <p class="bashara-page__body">{{ s.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="bashara-about-ingredients__grid">
      {%- for block in section.blocks -%}
        <article class="bashara-about-ingredients__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="bashara-about-ingredients__item-image">
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: block.settings.image.alt | default: block.settings.title
              }}
            </div>
          {%- endif -%}
          <div class="bashara-about-ingredients__item-body">
            {%- if block.settings.title != blank -%}
              <h3 class="bashara-about-ingredients__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="bashara-about-ingredients__item-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bashara About Ingredients",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Centella Asiatica"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A soothing herb used for centuries in Korean skincare to calm and repair the skin barrier."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Key Ingredients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in nature, backed by science"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We select each ingredient for its proven benefits and time-honored place in Korean beauty rituals."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bashara About Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Centella Asiatica",
            "text": "A soothing herb used for centuries in Korean skincare to calm and repair the skin barrier."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Rice Extract",
            "text": "Brightens and softens skin, a staple of traditional Korean beauty routines."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Green Tea",
            "text": "Rich in antioxidants to protect skin from environmental stress and premature aging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
