{{ 'bashara-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<div class="section-background color-{{ s.color_scheme }}"></div>
<section class="section color-{{ s.color_scheme }} bashara-page bashara-about-team">
  <div class="bashara-about-team__header">
    {%- if s.eyebrow != blank -%}
      <p class="bashara-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="bashara-heading-lg">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p class="bashara-about-team__desc">{{ s.description | escape }}</p>
    {%- endif -%}
  </div>

  <div class="bashara-about-team__grid">
    {%- for block in section.blocks -%}
      <div class="bashara-about-team__member" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="bashara-about-team__photo">
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.name
            }}
          </div>
        {%- endif -%}
        {%- if block.settings.name != blank -%}
          <h3 class="bashara-about-team__name">{{ block.settings.name | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.role != blank -%}
          <p class="bashara-about-team__role">{{ block.settings.role | escape }}</p>
        {%- endif -%}
        {%- if block.settings.bio != blank -%}
          <p class="bashara-about-team__bio">{{ block.settings.bio | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bashara About Team",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Sarah Kim"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Chief Formulation Officer"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "15+ years in cosmetic chemistry"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR TEAM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Experts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our team of dermatologists, chemists, and beauty experts work together to create products you can trust."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bashara About Team",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "name": "Dr. Sarah Kim",
            "role": "Chief Formulation Officer",
            "bio": "15+ years in cosmetic chemistry"
          }
        },
        {
          "type": "member",
          "settings": {
            "name": "Emily Chen",
            "role": "Brand Director",
            "bio": "Korean beauty expert & influencer"
          }
        },
        {
          "type": "member",
          "settings": {
            "name": "Dr. Jessica Park",
            "role": "Lead Dermatologist",
            "bio": "Board-certified dermatologist"
          }
        }
      ]
    }
  ]
}
{% endschema %}
