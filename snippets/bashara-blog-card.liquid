{%- doc -%}
  @param {object} article - The article object
{%- enddoc -%}

{%- liquid
  assign reading_time = article.metafields.custom.reading_time.value
  assign category = article.metafields.custom.primary_category.value | default: article.tags.first
  assign card_excerpt = article.excerpt | default: article.content
-%}

<a href="{{ article.url }}" class="bashara-blog-card">
  <div class="bashara-blog-card__media">
    {%- if article.image -%}
      {{
        article.image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 900',
          sizes: '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw',
          alt: article.image.alt | default: article.title
      }}
    {%- endif -%}
    {%- if category != blank -%}
      <span class="bashara-tag bashara-tag--on-image">{{ category }}</span>
    {%- endif -%}
  </div>

  <div class="bashara-blog-card__body">
    <div class="bashara-meta">
      <span class="bashara-meta__item">
        {% render 'bashara-icons', name: 'calendar', size: 'sm' %}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: format: 'date' }}
        </time>
      </span>
      {%- if reading_time != blank -%}
        <span class="bashara-meta__sep" aria-hidden="true">•</span>
        <span class="bashara-meta__item">
          {% render 'bashara-icons', name: 'clock', size: 'sm' %}
          <span>{{ reading_time }}</span>
        </span>
      {%- endif -%}
    </div>

    <h3 class="bashara-blog-card__title">{{ article.title }}</h3>

    <p class="bashara-blog-card__excerpt">
      {{ card_excerpt | strip_html | truncate: 120 }}
    </p>

    <span class="bashara-link bashara-link--sm">
      Read More
      {% render 'bashara-icons', name: 'arrow-right', size: 'sm' %}
    </span>
  </div>
</a>
