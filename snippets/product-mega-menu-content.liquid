{% comment %}
  Renders the content for a standard product mega menu.
  Accepts:
  - current_link_object: The parent navigation link object.
  - layout_columns: The number of columns for the layout.
  - featured_block: The product block to feature, if any (also used for items-per-column setting).
{% endcomment %}

{%- if featured_block -%}
  {%- assign items_per_col = featured_block.settings.mega_menu_items_per_column | default: 6 -%}
  {%- assign threshold_2 = items_per_col -%}
  {%- assign threshold_3 = items_per_col | times: 2 -%}
{%- endif -%}

<ul
  class="mega-menu__list mega-menu__list--product page-width{% if current_link_object.levels == 1 %} mega-menu__list--condensed{% endif %} columns-{{ layout_columns }}"
  role="list"
>
  {%- for childlink in current_link_object.links -%}
    {%- if featured_block and childlink.links != blank -%}
      {%- assign sublist_size = childlink.links.size -%}
      {%- if sublist_size >= threshold_3 -%}
        {%- assign li_span_class = 'mega-menu__col--span-3' -%}
      {%- elsif sublist_size >= threshold_2 -%}
        {%- assign li_span_class = 'mega-menu__col--span-2' -%}
      {%- else -%}
        {%- assign li_span_class = '' -%}
      {%- endif -%}
    {%- else -%}
      {%- assign li_span_class = '' -%}
    {%- endif -%}
    <li class="{{ li_span_class }}">
      <a
        id="HeaderMenu-{{ current_link_object.handle }}-{{ childlink.handle }}"
        href="{{ childlink.url }}"
        class="mega-menu__link mega-menu__link--level-2 link mega-menu__link mega-menu__link--parent{% if childlink.current %} mega-menu__link--active{% endif %}"
        {% if childlink.current %}
          aria-current="page"
        {% endif %}
      >
        {{ childlink.title | escape }}
      </a>
      {%- if childlink.links != blank -%}
        {%- if featured_block -%}
          {%- if sublist_size >= threshold_3 -%}
            {%- assign sublist_col_class = 'mega-menu__sublist--cols-3' -%}
          {%- elsif sublist_size >= threshold_2 -%}
            {%- assign sublist_col_class = 'mega-menu__sublist--cols-2' -%}
          {%- else -%}
            {%- assign sublist_col_class = '' -%}
          {%- endif -%}
        {%- else -%}
          {%- assign sublist_col_class = '' -%}
        {%- endif -%}
        <ul class="mega-menu__sublist list-unstyled {{ sublist_col_class }}" role="list">
          {%- for grandchildlink in childlink.links -%}
            <li>
              <a
                id="HeaderMenu-{{ current_link_object.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                href="{{ grandchildlink.url }}"
                class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                {% if grandchildlink.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ grandchildlink.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </li>
  {%- endfor -%}

  {%- comment %}
    The original code looped through section.blocks again here.
    However, the parent snippet (header-mega-menu.liquid) already determines
    the specific `featured_block` that matches the `current_link_object`.
    So we can just render it directly if it exists.
  {% endcomment %}
  {%- if featured_block -%}
    {% render 'featured-mega-menu-items', block: featured_block %}
  {%- endif -%}
</ul> 