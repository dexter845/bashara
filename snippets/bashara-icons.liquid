{%- comment -%}
  @param {string} name - calendar, clock, arrow-left, arrow-right, share
  @param {string} [size] - sm for 12px variants
{%- endcomment -%}

{%- case name -%}
  {%- when 'calendar' -%}
    <svg class="bashara-icon bashara-icon--calendar{% if size == 'sm' %} bashara-icon--calendar-sm{% endif %}" width="{% if size == 'sm' %}12{% else %}16{% endif %}" height="{% if size == 'sm' %}12{% else %}16{% endif %}" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
      <path d="M2 6.5h12M5.5 1.5V4M10.5 1.5V4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  {%- when 'clock' -%}
    <svg class="bashara-icon bashara-icon--clock{% if size == 'sm' %} bashara-icon--clock-sm{% endif %}" width="{% if size == 'sm' %}12{% else %}16{% endif %}" height="{% if size == 'sm' %}12{% else %}16{% endif %}" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2"/>
      <path d="M8 5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'arrow-left' -%}
    <svg class="bashara-icon bashara-icon--arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M10 3.5L5.5 8 10 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'arrow-right' -%}
    <svg class="bashara-icon bashara-icon--arrow{% if size == 'sm' %} bashara-icon--arrow-sm{% endif %}" width="{% if size == 'sm' %}12{% else %}16{% endif %}" height="{% if size == 'sm' %}12{% else %}16{% endif %}" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M6 3.5L10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'share' -%}
    <svg class="bashara-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="12" cy="3.5" r="1.75" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="4" cy="8" r="1.75" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="12" cy="12.5" r="1.75" stroke="currentColor" stroke-width="1.2"/>
      <path d="M5.6 7.1l4.3-2.4M5.6 8.9l4.3 2.4" stroke="currentColor" stroke-width="1.2"/>
    </svg>
{%- endcase -%}
